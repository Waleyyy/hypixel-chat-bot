# Minecraft Account Configuration
MINECRAFT_EMAIL=your_minecraft_email@example.com
MINECRAFT_PASSWORD=your_minecraft_password

# Or use Microsoft account authentication
# MINECRAFT_AUTH=microsoft

# Hypixel API Key (get from https://api.hypixel.net/)
HYPIXEL_API_KEY=your_hypixel_api_key_here

# Bot Configuration
BOT_USERNAME=your_bot_minecraft_username
GUILD_NAME=Your Guild Name Here

# Optional: Reconnection settings
RECONNECT_DELAY=5000
MAX_RECONNECT_ATTEMPTS=10

# Optional: Command prefix (default is !)
COMMAND_PREFIX=!

# Optional: Debug mode
DEBUG=false

# Message delivery method (true for private messages, false for guild chat)
USE_PRIVATE_MESSAGES=true
